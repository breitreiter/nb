<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <ApplicationIcon>nb.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- The CLI shell: Program + CommandProcessor + the line-editor mention source.
       The engine lives in nb.Core; UglyPrompt (line editor) is CLI-only. Everything
       else (Spectre, config, MCP, Microsoft.Extensions.AI) flows transitively. -->
  <ItemGroup>
    <PackageReference Include="UglyPrompt" Version="0.4.0" />
    <PackageReference Include="Spectre.Console" Version="0.52.1-preview.0.4" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="nb.Core\nb.Core.csproj" />
  </ItemGroup>

  <!-- Sibling projects/source that sit under the globbed root but aren't ours. -->
  <ItemGroup>
    <Compile Remove="nb.Core\**" />
    <EmbeddedResource Remove="nb.Core\**" />
    <None Remove="nb.Core\**" />
    <Compile Remove="Providers\**" />
    <EmbeddedResource Remove="Providers\**" />
    <None Remove="Providers\**" />
    <Compile Remove="mcp-servers\**" />
    <None Remove="mcp-servers\**" />
    <Compile Remove="nb.Tests\**" />
    <EmbeddedResource Remove="nb.Tests\**" />
    <None Remove="nb.Tests\**" />
    <Compile Remove="nb-builds\**" />
    <EmbeddedResource Remove="nb-builds\**" />
    <None Remove="nb-builds\**" />
  </ItemGroup>

  <!-- Runtime content deployed next to the Exe, where AppContext.BaseDirectory finds it. -->
  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- License and attribution must ship alongside the binaries: the MIT and
         Apache-2.0 components in THIRD-PARTY-NOTICES.md require their notices
         to be reproduced in binary redistributions. -->
    <None Update="LICENSE.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="THIRD-PARTY-NOTICES.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="prompts\*.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="mcp.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="theme.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="CopyProvidersAfterPublish" AfterTargets="Publish" Condition="'$(RuntimeIdentifier)' != ''">
    <ItemGroup>
      <ProviderDirs Include="$(SolutionDir)bin\$(Configuration)\net10.0\$(RuntimeIdentifier)\providers\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(ProviderDirs)" DestinationFolder="$(PublishDir)providers\%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>

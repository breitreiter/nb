<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <ApplicationIcon>nb.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- The CLI shell: Program only. The engine lives in nb.Core; everything else
       (Spectre, config, MCP, Microsoft.Extensions.AI) flows transitively. -->
  <ItemGroup>
    <PackageReference Include="Spectre.Console" Version="0.52.1-preview.0.4" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="nb.Core\nb.Core.csproj" />
  </ItemGroup>


  <!-- Sibling projects/source that sit under the globbed root but aren't ours. -->
  <ItemGroup>
    <Compile Remove="nb.Core\**" />
    <EmbeddedResource Remove="nb.Core\**" />
    <None Remove="nb.Core\**" />
    <Compile Remove="Providers\**" />
    <EmbeddedResource Remove="Providers\**" />
    <None Remove="Providers\**" />
    <Compile Remove="mcp-servers\**" />
    <None Remove="mcp-servers\**" />
    <Compile Remove="nb.Tests\**" />
    <EmbeddedResource Remove="nb.Tests\**" />
    <None Remove="nb.Tests\**" />
    <Compile Remove="nb-builds\**" />
    <EmbeddedResource Remove="nb-builds\**" />
    <None Remove="nb-builds\**" />
  </ItemGroup>

  <!-- Runtime content deployed next to the Exe, where AppContext.BaseDirectory finds it. -->
  <ItemGroup>
    <!-- Build output only. The developer's appsettings.json holds live API keys;
         publishing it would ship them in the distribution artifact. A published
         binary gets its configuration from the config flag, or from an appsettings.json
         placed next to it after the fact (it is optional at load). -->
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </None>
    <None Update="appsettings.example.json">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <!-- License and attribution must ship alongside the binaries: the MIT and
         Apache-2.0 components in THIRD-PARTY-NOTICES.md require their notices
         to be reproduced in binary redistributions. -->
    <None Update="LICENSE.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="THIRD-PARTY-NOTICES.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="prompts\*.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="mcp.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="theme.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Providers are plugins: nothing here may reference their assemblies (they load into
       their own AssemblyLoadContext), so publish builds them explicitly and collects the
       result. Doing it here rather than relying on the solution build fixes two silent
       failures: publishing nb.csproj alone produced an artifact with no providers, and
       even a solution publish raced — nothing ordered the providers' copy-to-bin before
       this target read that directory.

       Providers build WITHOUT the RuntimeIdentifier: a plugin runs on the host's runtime,
       so it needs no RID of its own, and a RID build needs a RID restore — which a plain
       `dotnet restore` has not done, so it failed NETSDK1047 on a clean checkout. Built
       plainly, they land in the same bin\<Config>\net10.0\providers the dev loop uses,
       and this target collects them from there.

       Publish nb.csproj on its own, never the solution: a solution-level publish built
       the same provider projects on other nodes concurrently with this target's build of
       them, and the two raced over one output directory (MSB3030, a different provider
       each run — the CI failure of 2026-09-14).

       Paths are anchored to this file rather than $(SolutionDir), which is empty when a
       project is built on its own — the original cause of the zero-provider copy. -->
  <Target Name="BuildProvidersForPublish" Condition="'$(RuntimeIdentifier)' != ''">
    <ItemGroup>
      <ProviderProjects Include="$(MSBuildThisFileDirectory)Providers\*\nb.Providers.*Provider.csproj" />
    </ItemGroup>
    <!-- Restore first, in its own evaluation: nothing else restores the providers when
         nb.csproj is published on its own from a clean checkout (the Containerfile's
         case; CI happened to restore the solution first). Restore and Build must not
         share a project instance — the assets file Build reads would be stale — so the
         extra property forces a fresh evaluation for the Build call, which is MSBuild's
         own documented shape for this. -->
    <MSBuild Projects="@(ProviderProjects)"
             Targets="Restore"
             Properties="Configuration=$(Configuration);RuntimeIdentifier=;SelfContained=false;RestoreOnly=true" />
    <MSBuild Projects="@(ProviderProjects)"
             Targets="Build"
             Properties="Configuration=$(Configuration);RuntimeIdentifier=;SelfContained=false" />
  </Target>

  <Target Name="CopyProvidersAfterPublish" AfterTargets="Publish"
          DependsOnTargets="BuildProvidersForPublish" Condition="'$(RuntimeIdentifier)' != ''">
    <PropertyGroup>
      <ProviderSourceDir>$(MSBuildThisFileDirectory)bin\$(Configuration)\net10.0\providers</ProviderSourceDir>
    </PropertyGroup>
    <ItemGroup>
      <ProviderDirs Include="$(ProviderSourceDir)\**\*.*" />
    </ItemGroup>
    <Warning Condition="'@(ProviderDirs)' == ''"
             Text="No provider plugins found at $(ProviderSourceDir) — the published binary will start with no providers loaded." />
    <Copy SourceFiles="@(ProviderDirs)" DestinationFolder="$(PublishDir)providers\%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>

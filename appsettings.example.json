{
  "//": "Copy to appsettings.json and fill in your provider endpoint(s) and key(s).",
  "//2": "Any value may reference an environment variable as ${VAR} (expanded at startup)",
  "//3": "if you'd rather not keep secrets in the file.",
  "//4": "ActiveProvider matches a ChatProviders entry's Name. Name is a free-form label;",
  "//5": "add an optional Provider field to name the implementation behind it, and several",
  "//6": "entries can then share one implementation (see LocalCoder/LocalAir below).",
  "MaxToolCalls": 25,
  "BashTimeoutSeconds": 120,
  "MaxContextTokens": 128000,
  "CompactionThreshold": 0.75,
  "Trust": false,
  "ActiveProvider": "AzureOpenAI",
  "ChatProviders": [
    {
      "Name": "AzureOpenAI",
      "Endpoint": "https://your-resource-name.openai.azure.com/",
      "ApiKey": "your-api-key-here",
      "ChatDeploymentName": "o4-mini"
    },
    {
      "Name": "AzureFoundry",
      "Endpoint": "https://your-resource-name.cognitiveservices.azure.com/",
      "ApiKey": "your-api-key-here",
      "Model": "gpt-5.3-codex",
      "EditToolStyle": "ApplyPatch"
    },
    {
      "Name": "Anthropic",
      "ApiKey": "your-anthropic-api-key-here",
      "Model": "claude-3-7-sonnet-20250219",
      "MaxContextTokens": 200000
    },
    {
      "Name": "OpenAI",
      "ApiKey": "sk-your-openai-api-key-here",
      "Model": "gpt-4o-mini"
    },
    {
      "Name": "Gemini",
      "ApiKey": "your-gemini-api-key-here",
      "Model": "gemini-2.0-flash-exp",
      "MaxContextTokens": 1000000
    },
    {
      "Name": "LocalLlm",
      "Endpoint": "http://your-local-llm-server:8080/v1",
      "ApiKey": "local",
      "Model": "GLM-4.5-Air-Q6_K-00001-of-00002.gguf",
      "MaxContextTokens": 131072,
      "Temperature": 0.2
    },
    {
      "//": "Two labels on one implementation: same LocalLlm plugin, different servers.",
      "//2": "Select with ActiveProvider or /provider, no config editing to switch.",
      "Name": "LocalCoder",
      "Provider": "LocalLlm",
      "Endpoint": "http://your-local-llm-server:8081/v1",
      "ApiKey": "local",
      "Model": "qwen3-coder-next",
      "MaxContextTokens": 131072
    },
    {
      "Name": "LocalAir",
      "Provider": "LocalLlm",
      "Endpoint": "http://your-local-llm-server:8082/v1",
      "ApiKey": "local",
      "Model": "glm-4.5-air",
      "MaxContextTokens": 65536
    }
  ]
}
